<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="WoodBlock" tooltip="Helper text" usage-hints="-1" focusable="true" style="flex-grow: 1; width: auto; height: 45px; margin-top: 6px; margin-right: 6px; margin-bottom: 3px; margin-left: 6px; background-color: rgba(40, 39, 39, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-text-outline-color: rgba(50, 50, 50, 0); -unity-text-outline-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 1px; border-left-width: 0; border-left-color: rgb(63, 63, 63); border-right-color: rgb(63, 63, 63); border-top-color: rgb(63, 63, 63); border-bottom-color: rgb(34, 34, 34); justify-content: center; align-items: stretch; overflow: hidden; background-image: none; white-space: nowrap; flex-direction: row; align-self: auto; align-content: flex-start; max-height: 45px; padding-bottom: 3px;">
        <engine:VisualElement name="IndicatorBlock" style="flex-grow: 0; width: 12px; max-width: 12px; margin-right: 4px; background-color: rgb(34, 31, 31); border-right-width: 0; border-right-color: rgb(38, 38, 38); justify-content: space-around; align-items: center;">
            <engine:VisualElement name="Led" style="flex-grow: 0; width: 4px; height: 4px; max-width: 4px; max-height: 4px; background-color: rgb(0, 255, 130); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; border-top-width: 0; border-top-color: rgb(61, 61, 61); border-right-color: rgb(45, 45, 45); border-right-width: 0;" />
        </engine:VisualElement>
        <engine:VisualElement name="Preview" style="flex-grow: 0; width: 28px; margin-top: 0; margin-right: 9px; margin-bottom: 0; margin-left: 0; background-color: rgb(34, 31, 31); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; min-width: 44px; align-content: flex-start;" />
        <engine:VisualElement name="Content" style="flex-grow: 1;">
            <engine:Label text="Heal&#10;" name="Title" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 10px; color: rgb(186, 186, 186); flex-grow: 1; flex-wrap: wrap; white-space: normal; align-content: auto; flex-shrink: 1; -unity-font-style: bold; max-height: 16px;" />
            <engine:Label text="Create fantastic magic effect" name="Description" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 10px; color: rgb(112, 112, 112); flex-grow: 1; flex-wrap: wrap; white-space: normal; align-content: auto; flex-shrink: 1;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
