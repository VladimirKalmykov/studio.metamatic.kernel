.Header {
    color: #3E4140;
    font-size: 14px;
    margin-bottom: 6px;
    border-radius: 4px;
    height: 32px;
    flex-direction: row;
    align-items: center;
}

.Header Label.Title {
    font-size: 14px;
    color: #272929;
    -unity-font-style: bold;
}

.Header .TypeContainer {
    background-color: #2E2E2E;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
    border-radius: 4px;
    padding: 0 4px;
}

.Header Label.Type {
    font-size: 12px;
    color: #9EFFAF;
    margin-top: 2px;
}

.Settings {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 6px;
}

.Settings > * {
    margin-bottom: 4px;
}