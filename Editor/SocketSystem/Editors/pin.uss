.StatusBar {
    flex-direction: row;
    justify-content: space-between;
}

.PinBlockContainer {
    flex-direction: row;
    flex-wrap: nowrap;
}

.PinBlock {
    flex-direction: row;
    flex-wrap: nowrap;
    background-color: #323232;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 3px;
    align-items: center;
}

.StatusCircle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #262626;
}

.StatusCircle_Enabled {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #09defe;
    border-color: #262626;
    border-width: 3px;
}

.StatusCircle_Disconnected {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #ff0000;
    border-color: #262626;
    border-width: 3px;
}


.PinLabel {
    font-size: 11px;
    margin-left: 3px;
}

.PinBlockLine {
    margin-top: 4px;
    background-color: #323232;
    height: 4px;
    width: 30px;
}

.Hidden {
    display: none;
}

.PinBlockLineCircle {
    width: 8px;
    height: 8px;
    border-radius: 3px;
    background-color: #323232;
    margin-top: 2px;
}

.PinBlockLineCircle_Enabled {
    background-color: #3a3a3a;
    border-color: #323232;
    border-width: 3px;
}

.VirtualPin {
    background-color: #fffb00;
}

.PinBlockLineCircle_Active {
    background-color:#09defe;
    border-color: #323232;
    border-width: 3px;
}

/* Object inputs */
.ObjectInputsRow {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 2px;
    flex-wrap: nowrap;
}

.ObjectInputsRow > * {
    max-width: 50%;
}

.OutputPinObjectFieldContainer {
    flex-direction: column;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-start;
}

.OutputPinObjectFieldContainer > * {
    margin-top: 2px;
}