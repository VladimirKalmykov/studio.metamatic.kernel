.GenericObjectField {
    background-color: rgb(40, 40, 40);
    border-color: rgb(40, 40, 40);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(210, 210, 210);
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    font-size: 12px;
    margin: 1px -2px 1px 3px;
    overflow: hidden;
    flex-basis: 0;
}

.GenericObjectField:hover {
    border-color: rgb(82, 82, 82);
}

.GenericObjectField.Active {
    border-color: rgb(58, 121, 187);
}

.GenericObjectField.Droppable {
    background-color: #376b6b;
}

.GenericObjectField > .GenericObjectFieldDisplay {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    font-size: 12px;
    -unity-slice-bottom: 4;
    -unity-slice-left: 4;
    -unity-slice-right: 4;
    -unity-slice-top: 4;
}

.GenericObjectField > .GenericObjectFieldDisplay > Label {
    color: rgb(91, 91, 91);
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 0;
    font-size: 12px;
    margin-left: 2px;
    margin-top: 0;
    padding: 1px 2px 0 0;
    white-space: nowrap;
}

.GenericObjectField.Droppable > .GenericObjectFieldDisplay > Label {
    color: white;
}

.GenericObjectField > .GenericObjectFieldDisplay > Label.HasValue {
    color: white;
}



.ClearBtn {
    width: 16px;
    height: 100%;
    background-color: #313131;
    border-width: 1px;
    border-color: #313131;
    border-radius: 2px;
    color: rgb(91, 91, 91);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ClearBtn:hover {
    background-color: #505050;
}

.ClearBtnIcon {
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-color: #939393;
    border-radius: 4px;
}

.ClearBtn:hover .ClearBtnIcon {
    border-color: white;
}

.ReadOnly .ClearBtn {
    display: none;
}
