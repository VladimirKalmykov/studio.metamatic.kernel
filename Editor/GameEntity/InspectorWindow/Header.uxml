<?xml version="1.0" encoding="utf-8"?>
<engine:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:engine="UnityEngine.UIElements"
>

    <engine:VisualElement class="Header">
        <engine:VisualElement class="HeaderIcon">
            <engine:Image name="MainIcon" />
        </engine:VisualElement>
        <engine:VisualElement class="HeaderBody">
            <engine:Label name="Title" />
            <engine:TextElement name="Description" />
            <engine:VisualElement name="Tools" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>