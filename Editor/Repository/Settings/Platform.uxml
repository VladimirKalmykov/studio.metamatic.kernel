                    <ui:Button text="Remove" name="RemoveButton" style="align-items: stretch; align-self: flex-start;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SourceSettings" style="flex-grow: 2;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
