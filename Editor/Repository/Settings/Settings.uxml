<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/studio.metamatic.kernel/Editor/Repository/Settings/Settings.uss?fileID=7433441132597879392&amp;guid=3d2937dc73ffa8547befbeb58b88c537&amp;type=3#Settings" />
    <ui:VisualElement name="Container" style="flex-grow: 1; border-left-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; align-self: stretch;">
        <ui:VisualElement name="Header" style="flex-grow: 0; height: auto; min-height: 35px; padding-left: 6px; padding-right: 6px;">
            <ui:Label text="Platforms" name="Title" style="font-size: 24px; -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:VisualElement name="Toolbar" style="flex-grow: 0; min-height: auto; flex-direction: row; margin-bottom: 6px; padding-left: 6px; padding-right: 6px;">
            <ui:DropdownField name="PlatformDropdown" style="width: 219px; margin-left: 0; margin-right: 0; margin-bottom: 0; margin-top: 0;" />
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; flex-wrap: nowrap;">
                <ui:Button text="Add platform" name="AddPlatformButton" style="align-self: flex-start;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="PlatformSources" vertical-scroller-visibility="AlwaysVisible" style="flex-grow: 2; padding-top: 6px; padding-left: 6px; padding-bottom: 6px; padding-right: 6px;" />
    </ui:VisualElement>
</ui:UXML>
