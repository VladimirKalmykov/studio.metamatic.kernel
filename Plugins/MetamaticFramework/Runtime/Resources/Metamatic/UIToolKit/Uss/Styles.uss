:root {
    --MetamaticUIKit_TextColor: #f0f0f0;
    --MetamaticUIKit_BackgroundColor: #1e1e1e;
    --MetamaticUIKit_InputColor: #161616;
    --MetamaticUIKit_BorderColor: #282828;
    --MetamaticUIKit_BorderLightColor: #3a3a3a;
    --MetamaticUIKit_PanelBackgroundColor: #222222;
    --MetamaticUIKit_TransclucentPanelBackgroundColor: rgba(34, 34, 34, 0.8);
    --MetamaticUIKit_PanelInactiveBackgroundColor: #1a1a1a;
    --MetamaticUIKit_IndicatorUnactiveColor: #4d4d4d;
    --MetamaticUIKit_IndicatorActiveColor: #1bffdd;
}

/* Darkify build-in visual elements */
.MetamaticUIKit_DarkEnough .unity-base-field {
    color: var(--MetamaticUIKit_TextColor);
}

.MetamaticUIKit_DarkEnough .unity-base-field__input {
    background-color: var(--MetamaticUIKit_InputColor);
    padding: 3px 6px;
    border-radius: 3px;
    border-color: rgba(0, 0, 0, 0);
}

/* Common styles */

.MetamaticUIKit_PaddedContent {
    padding: 6px;
}

.MetamaticUIKit_VerticalLayout {
    flex-direction: column;
    padding-bottom: -6px !important;
}

.MetamaticUIKit_VerticalLayout > * {
    margin: 0 0 6px 0;
}

/* KeyValueList */
.MetamaticUIKit_KeyValueList {
    flex-direction: column;
    padding: 0 0 0 0;
}

.MetamaticUIKit_KeyValueList .MetamaticUIKit_KeyValue {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.MetamaticUIKit_KeyValueList .MetamaticUIKit_KeyValue .MetamaticUIKit_Key {
    margin-right: 6px;
    flex-grow: 0;
    flex-shrink: 1;
}

.MetamaticUIKit_KeyValueList .MetamaticUIKit_KeyValue .MetamaticUIKit_KeyValueValue {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Items list */
.MetamaticUIKit_ItemsList {
    flex-direction: column;
    padding: 0;
}

.MetamaticUIKit_ItemsList .MetamaticUIKit_Item {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
    border-radius: 3px;
    color: var(--MetamaticUIKit_TextColor);
}

.MetamaticUIKit_ItemsList .MetamaticUIKit_Item .MetamaticUIKit_ItemIndicator {
    width: 4px;
    height: 4px;
    flex-basis: 4px;
    max-width: 4px;
    max-height: 4px;
    background-color: var(--MetamaticUIKit_IndicatorUnactiveColor);
    margin: 0 16px;
}

.MetamaticUIKit_ItemsList .MetamaticUIKit_Item.MetamaticUIKit_Selected .MetamaticUIKit_ItemIndicator {
    background-color: var(--MetamaticUIKit_IndicatorActiveColor) !important;
}

.MetamaticUIKit_ItemsList .MetamaticUIKit_Item .MetamaticUIKit_ItemContent {
    flex-grow: 1;
}

/* Box group */
.MetamaticUIKit_BoxGroup {
    flex-direction: column;
    padding: 0;
}

.MetamaticUIKit_BoxGroup .MetamaticUIKit_BoxGroupHeader {
    flex-direction: row;
    align-items: center;
    padding: 0;
    color: var(--MetamaticUIKit_TextColor);
}

.MetamaticUIKit_BoxGroup .MetamaticUIKit_BoxGroupHeader Label {
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 6px 6px;
    margin: 0;
}

.MetamaticUIKit_BoxGroup .MetamaticUIKit_BoxGroupContent {
    flex-direction: column;
    padding: 0;
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* Table view */
.MetamaticUIKit_TableView {
    flex-direction: column;
    padding: 0;
}

.MetamaticUIKit_TableView_Header {
    flex-direction: row;
    align-items: center;
    padding: 0;
}

.MetamaticUIKit_TableView_HeaderCol {
    
}

.MetamaticUIKit_TableView_Row {
    flex-direction: row;
    align-items: center;
    padding: 0;
}

.MetamaticUIKit_TableView_Row .MetamaticUIKit_TableView_Cell {
    flex-grow: 0;
    flex-shrink: 0;
    padding: 6px 0;
    color: var(--MetamaticUIKit_TextColor);
    overflow: hidden;
}

/* Multi column view */
.MetamaticUIKit_MultiColumnsView {
    flex-direction: row;
    padding: 0;
    margin: 0 -6px;
}

.MetamaticUIKit_MultiColumnsView > * {
    flex-direction: column;
    padding: 0;
    flex-grow: 1;
    margin: 0 6px;
}

/* Tabs */
.MetamaticUIKit_Tabs {
    flex-direction: column;
}

.MetamaticUIKit_Tabs .MetamaticUIKit_TabsHeader {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--MetamaticUIKit_BorderColor);
}

.MetamaticUIKit_Tabs .MetamaticUIKit_TabsHeader .MetamaticUIKit_Tab {
    flex-grow: 0;
    padding: 2px 6px;
    margin: 0 3px 0 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background-color: var(--MetamaticUIKit_PanelInactiveBackgroundColor);
    color: var(--MetamaticUIKit_TextColor);
}

.MetamaticUIKit_Tabs .MetamaticUIKit_TabsHeader .MetamaticUIKit_Tab.MetamaticUIKit_Selected {
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
}

.MetamaticUIKit_Tabs .MetamaticUIKit_TabsContent {
    flex-direction: column;
    padding: 0;
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* Toggle button */
.MetamaticUIKit_ToggleButton {
    flex-direction: row;
    align-items: center;
    padding: 0;
    border-radius: 6px;
}

.MetamaticUIKit_ToggleButton .MetamaticUIKit_ToggleButtonChoice {
    flex-grow: 1;
    padding: 6px;
    border-radius: 6px;
    background-color: var(--MetamaticUIKit_PanelInactiveBackgroundColor);
    color: var(--MetamaticUIKit_TextColor);
}

.MetamaticUIKit_ToggleButton .MetamaticUIKit_ToggleButtonChoice.MetamaticUIKit_ToggleButtonChoiceSelected {
    background-color: var(--MetamaticUIKit_PanelBackgroundColor);
}

