.SpellCard {
    flex-grow: 1;
    width: auto;
    height: 45px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 3px;
    margin-left: 6px;
    background-color: rgba(40, 39, 39, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-text-outline-color: rgba(50, 50, 50, 0);
    -unity-text-outline-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-left-color: rgb(63, 63, 63);
    border-right-color: rgb(63, 63, 63);
    border-top-color: rgb(63, 63, 63);
    border-bottom-color: rgb(34, 34, 34);
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
    background-image: none;
    white-space: nowrap;
    flex-direction: row;
    align-self: auto;
    align-content: flex-start;
    max-height: 45px;
    padding-bottom: 3px;
}

.SpellCardIndicator {
    flex-grow: 0;
    width: 12px;
    max-width: 12px;
    margin-right: 4px;
    background-color: rgb(34, 31, 31);
    border-right-width: 0;
    border-right-color: rgb(38, 38, 38);
    justify-content: space-around;
    align-items: center;
}

.Led {
    flex-grow: 0;
    width: 4px;
    height: 4px;
    max-width: 4px;
    max-height: 4px;
    background-color: rgb(0, 255, 130);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-width: 0;
    border-top-color: rgb(61, 61, 61);
    border-right-color: rgb(45, 45, 45);
    border-right-width: 0;
}

.SpellCardPreview {
    flex-grow: 0;
    width: 28px;
    margin-top: 0;
    margin-right: 9px;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(34, 31, 31);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    min-width: 44px;
    align-content: flex-start;
}

.SpellCardContent {
    flex-grow: 1;
}

.SpellCardTitle {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    color: rgb(186, 186, 186);
    flex-grow: 1;
    flex-wrap: wrap;
    white-space: normal;
    align-content: auto;
    flex-shrink: 1;
    -unity-font-style: bold;
    max-height: 16px;
}

.SpellCardDescription {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    color: rgb(112, 112, 112);
    flex-grow: 1;
    flex-wrap: wrap;
    white-space: normal;
    align-content: auto;
    flex-shrink: 1;
}

.Panel {
    flex-grow: 1;
    position: absolute;
    background-color: rgb(32, 27, 27);
    width: 225px;
    height: 328px;
    top: 65px;
    left: 135px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.PanelHeader {
    flex-grow: 0;
    height: 31px;
    justify-content: flex-start;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(18, 18, 18);
    flex-direction: row;
    -unity-font-style: bold;
    font-size: 12px;
}

.PanelContent {
    flex-grow: 1;
    flex-direction: column-reverse;
    flex-wrap: wrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 1px;
    border-top-color: rgb(42, 40, 39);
    align-items: stretch;
    justify-content: flex-start;
    align-content: flex-start;
}

.PanelTitle {
    align-self: center;
    font-size: 14px;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(210, 210, 210);
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding-right: 0;
    padding-left: 0;
}

.PanelHeaderSpace {
    flex-grow: 1;
}
