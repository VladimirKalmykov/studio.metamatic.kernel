.SelectableItem {
    flex-grow: 1;
    width: auto;
    height: 64px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 3px;
    margin-left: 6px;
    background-color: rgba(40, 39, 39, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-text-outline-color: rgba(50, 50, 50, 0);
    -unity-text-outline-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-left-color: rgb(63, 63, 63);
    border-right-color: rgb(63, 63, 63);
    border-top-color: rgb(63, 63, 63);
    border-bottom-color: rgb(34, 34, 34);
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
    background-image: none;
    white-space: nowrap;
    flex-direction: row;
    align-self: auto;
    align-content: flex-start;
    max-height: 64px;
    padding-bottom: 3px;
}

.SelectableItemIndicator {
    flex-grow: 0;
    width: 12px;
    max-width: 12px;
    margin-right: 4px;
    background-color: rgb(34, 31, 31);
    border-right-width: 0;
    border-right-color: rgb(38, 38, 38);
    justify-content: space-around;
    align-items: center;
}

.Led {
    flex-grow: 0;
    width: 4px;
    height: 4px;
    max-width: 4px;
    max-height: 4px;
    background-color: rgb(64, 64, 64);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-width: 0;
    border-top-color: rgb(61, 61, 61);
    border-right-color: rgb(45, 45, 45);
    border-right-width: 0;
}

.SelectableItem.Selected .Led {
    background-color: rgb(0, 255, 130);
}

.SelectableItemPreview {
    flex-grow: 0;
    width: 28px;
    margin-top: 0;
    margin-right: 9px;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(34, 31, 31);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    min-width: 44px;
    align-content: flex-start;
}

.SelectableItemContent {
    flex-grow: 1;
}

.SelectableItemTitle {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 16px;
    color: rgb(186, 186, 186);
    flex-grow: 1;
    flex-wrap: wrap;
    white-space: normal;
    align-content: auto;
    flex-shrink: 1;
    -unity-font-style: bold;
    max-height: 16px;
}

.SelectableItemDescription {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    color: rgb(112, 112, 112);
    flex-grow: 1;
    flex-wrap: wrap;
    white-space: normal;
    align-content: auto;
    flex-shrink: 1;
}

.Panel {
    flex-grow: 1;
    position: absolute;
    background-color: rgb(32, 27, 27);
    width: 225px;
    height: 328px;
    color: rgb(186, 186, 186);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.PanelHeader {
    flex-grow: 0;
    height: 32px;
    justify-content: flex-start;
    padding-left: 12px;
    padding-right: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(18, 18, 18);
    flex-direction: row;
    -unity-font-style: bold;
    font-size: 12px;
}

.PanelContent {
    flex-grow: 1;
    flex-direction: column-reverse;
    flex-wrap: wrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 1px;
    border-top-color: rgb(42, 40, 39);
    align-items: stretch;
    justify-content: flex-start;
    align-content: flex-start;
}

.PanelTitle {
    align-self: center;
    font-size: 18px;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(210, 210, 210);
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding-right: 0;
    padding-left: 0;
}

.PanelHeaderSpace {
    flex-grow: 1;
}

.PanelHeaderRightButton {
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 16px;
    height: 16px;
}

.ToolItem {
    flex-grow: 1;
    flex-direction: row;
    height: 64px;
    max-height: 64px;
    border-bottom-width: 0;
    border-bottom-color: rgb(64, 64, 64);
    background-color: rgba(56, 56, 56, 0);
}

.ToolItemIcon {
    flex-grow: 1;
    width: 64px;
    height: 64px;
    max-width: 64px;
    max-height: 64px;
    margin-right: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.ToolItem.Active .ToolItemIcon {
    border-bottom-width: 0;
    border-bottom-color: rgb(58, 58, 58);
    background-color: rgb(69, 69, 69);
}

.ToolItemIcon .IconImage {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
}

.ToolItemContent {
    flex-grow: 1;
    margin-left: 6px;
}

.ToolItemContentLabel {
    color: rgb(191, 191, 191);
    margin-top: 2px;
    font-size: 16px;
}

.VerticalItemsContainer {
    padding: 3px;
    flex-direction: column;
}

.CursorText {
    background-color: rgb(51, 51, 51);
    color: rgb(255, 255, 255);
    font-size: 18px;
    padding-left: 4px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-direction: row;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(149, 149, 149);
    border-right-color: rgb(149, 149, 149);
    border-top-color: rgb(149, 149, 149);
    border-bottom-color: rgb(149, 149, 149);
    position: absolute;
    top: 0;
    left: 0;
}

.Bounds {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 12px;
    padding-left: 4px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-direction: row;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(149, 149, 149);
    border-right-color: rgb(149, 149, 149);
    border-top-color: rgb(149, 149, 149);
    border-bottom-color: rgb(149, 149, 149);
    position: absolute;
    top: 0;
    left: 0;
}

.Form {
    color: rgb(197, 197, 197);
}

.FormContent {
    padding: 12px;
    flex-direction: column;
}

.FormFooter {
    border-top-width: 1px;
    border-top-color: rgb(44, 44, 44);
    padding: 12px;
    flex-direction: row;
    flex-wrap: wrap;
}

.Form .unity-base-field {
    margin: 0;
    height: 32px;
}

.Form .unity-base-field__input {
    background-color: rgb(44, 44, 44);
    color: rgb(197, 197, 197);
    border-color: rgb(60, 60, 60);
    border-radius: 4px;
    padding: 0 8px;
    height: 26px;
}

.Field {
    flex-grow: 1;
    flex-direction: row;
}

.FieldLabel {
    color: rgb(186, 186, 186);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 6px;
    margin-bottom: 0;
    margin-left: 0;
    width: 80px;
    max-width: 120px;
    min-width: 120px;
    flex-wrap: wrap;
    white-space: normal;
}

.FieldContent {
    flex-grow: 1;
}

Button {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 6px;
    padding-right: 12px;
    padding-bottom: 6px;
    padding-left: 12px;
    background-color: rgb(0, 91, 93);
    color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    cursor: link;
}

Button:disabled {
    background-color: rgb(44, 44, 44);
    color: rgb(186, 186, 186);
    cursor: arrow;
}

.FormMessage {
    color: rgb(255, 255, 255);
    font-size: 12px;
    padding: 6px;
    margin: 0 6px 0 0;
    flex-wrap: wrap;
    white-space: normal;
    background-color: rgb(44, 44, 44);
    border-radius: 6px;
    flex-grow: 1;
}
