<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/studio.metamatic.kernel/Runtime/DevMagicWoods/Uss/Desktop.uss?fileID=7433441132597879392&amp;guid=cba207de8508ee746acd20a804b0dccc&amp;type=3#Desktop" />
    <engine:VisualElement name="SpellCard" tooltip="Helper text" usage-hints="-1" focusable="true" class="SpellCard">
        <engine:VisualElement name="IndicatorBlock" class="SpellCardIndicator">
            <engine:VisualElement name="Led" class="Led" />
        </engine:VisualElement>
        <engine:VisualElement name="Preview" class="SpellCardPreview" />
        <engine:VisualElement name="Content" class="SpellCardContent">
            <engine:Label text="Heal&#10;" name="Title" class="SpellCardTitle" />
            <engine:Label text="Create fantastic magic effect" name="Description" class="SpellCardDescription" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
