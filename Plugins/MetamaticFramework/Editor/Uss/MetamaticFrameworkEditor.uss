.MetamaticFrameworkEditor .IconPack {
    flex-direction: column;
    margin-bottom: 12px;
}

.MetamaticFrameworkEditor .IconPack .Header {
    color: white;
    font-size: 16px;
    margin: 0 0 12px 0;
    padding: 0 0 0 6px;
}

.MetamaticFrameworkEditor .IconPack .Content {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6px 0 0 6px;
}

.MetamaticFrameworkEditor .IconPack .Icon {
    background-color: #2c2c2c;
    margin: 0 6px 6px 0;
    padding: 6px;
    border-radius: 3px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

.MetamaticFrameworkEditor .IconPack .Icon Image {
    margin: 0 0 6px 0;
}

.MetamaticFrameworkEditor .IconPack .Icon Label {
    color: white;
}

.MetamaticFrameworkEditor .IconPack .Icon.Size12x12 {
    width: 12px;
    height: 12px;
}

.MetamaticFrameworkEditor .IconPack .Icon.Size16x16 {
    width: 16px;
    height: 16px;
}

.MetamaticFrameworkEditor .IconPack .Icon.Size24x24 {
    width: 24px;
    height: 24px;
}

.MetamaticFrameworkEditor .IconPack .Icon.Size32x32 {
    width: 32px;
    height: 32px;
}