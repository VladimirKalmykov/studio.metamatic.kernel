        <engine:VisualElement name="Icon" class="ToolItemIcon" style="width: 24px; height: 24px; max-width: 24px; max-height: 24px; align-items: center; justify-content: center;" />
        <engine:VisualElement name="Content" class="ToolItemContent" style="height: 24px; align-content: flex-start; align-items: stretch; justify-content: center;">
